APP_NAME="Eldritch Arena"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eldritch_arena
DB_USERNAME=eldritch
DB_PASSWORD=
DB_SSLMODE=prefer

# Usado apenas pelo comando opcional de importação do protótipo SQLite.
LEGACY_DB_DATABASE=database/database.sqlite

# Habilite apenas no ambiente de demonstração local, nunca em produção.
DEMO_PREMIUM_SUBSCRIPTION=true

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_LEVEL=debug
